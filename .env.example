NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=root
NUXT_DB_PASSWORD=
NUXT_DB_NAME=portal_site

# Tencent COS (private bucket) — server signs temporary icon URLs
# Leave empty to use local /uploads paths from public/
NUXT_COS_SECRET_ID=
NUXT_COS_SECRET_KEY=
NUXT_COS_BUCKET=examplebucket-1250000000
NUXT_COS_REGION=ap-guangzhou
# Optional: if object keys need a prefix; usually leave empty when Key is uploads/...
NUXT_COS_PREFIX=
# Signed URL lifetime (seconds)
NUXT_COS_EXPIRES=3600
# Optional custom/CDN domain without protocol
NUXT_COS_DOMAIN=
